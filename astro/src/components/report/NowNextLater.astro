---
import Icon from '../ui/Icon';
const columns = [{ title: 'Now', icon: 'app', items: ['Inventory MoveUp and define the MVP evidence.', 'Review the E003 carrier against measured modules.'] }, { title: 'Next', icon: 'next', items: ['Build and test the reduced sensor direction.', 'Run real daily-use testing and record findings.'] }, { title: 'Later', icon: 'enclosure', items: ['Design an enclosure around the validated geometry.', 'Decide commercial, open-source and compliance scope.'] }];
---
<section id="roadmap" class="report-container py-16 md:py-20"><div class="mb-10"><p class="mb-3 text-xs font-semibold uppercase tracking-[0.24em] text-brand-text">Roadmap</p><h2 class="text-3xl text-ink md:text-4xl">Now, next, later</h2></div><div class="grid gap-5 md:grid-cols-3">{columns.map((column) => <div class="rounded-2xl border border-line bg-surface p-6"><div class="flex items-center gap-3"><Icon name={column.icon} size={21} /><h3 class="text-xl text-ink">{column.title}</h3></div><ul class="mt-5 space-y-4 text-sm leading-6 text-ink-muted">{column.items.map((item) => <li class="border-t border-line pt-3">{item}</li>)}</ul></div>)}</div></section>
