---
import Icon from '../ui/Icon';
import StatusPill from './StatusPill.astro';
import { versions } from '../../data/project-status';
---
<section id="versions" class="report-container py-16 md:py-20">
  <div class="mb-10 flex items-end justify-between gap-4"><div><p class="mb-3 text-xs font-semibold uppercase tracking-[0.24em] text-brand-text">Version history</p><h2 class="text-3xl text-ink md:text-4xl">What changed</h2></div><a class="report-link hidden text-sm sm:block" href="/versions">All updates</a></div>
  <div class="relative left-[2px] space-y-0 border-l border-line">
    {versions.map((entry) => <article class="relative ml-5 border-b border-line py-6 pl-6 first:pt-0">
      <span class="absolute -left-6 top-7 h-2 w-2 rounded-full bg-brand-strong ring-4 ring-bg"></span>
      <div class="flex flex-wrap items-center gap-3"><h3 class="text-xl text-ink">{entry.label}</h3><StatusPill state={entry.state} /></div>
      <p class="mt-3 max-w-2xl leading-7 text-ink-muted">{entry.summary}</p><p class="mt-2 max-w-2xl text-sm leading-6 text-ink-muted"><strong class="text-ink-muted">Why:</strong> {entry.why}</p>
      {entry.href && <a class="report-link mt-3 inline-block text-sm" href={entry.href}>Read the decision record</a>}
    </article>)}
  </div>
</section>
