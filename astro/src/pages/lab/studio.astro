---
import '../../styles/fonts.css';
import '../../styles/global.css';
import StudioLab from '../../components/studio/StudioLab';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Lab: scene studio — Open Smart Desk</title>
  </head>
  <body class="bg-bg text-ink" style="min-height: 100vh; padding: 32px 24px 20vh;">
    <main style="max-width: 1100px; margin: 0 auto;">
      <p style="font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-ink-muted);">
        Lab — scene studio (E005), not indexed
      </p>
      <h1 style="font-family: var(--font-display); font-size: 2rem; margin: 8px 0 12px;">
        Scene studio
      </h1>
      <p style="color: var(--color-ink-muted); max-width: 70ch; margin-bottom: 16px;">
        The panel on the right plays or scrubs the storyboard (the same <code>beatAt(u)</code> the
        homepage scroll uses), switches the figure (original vs our style), tunes the relaxed pose,
        the sensor colour and the cable. Drag to orbit (also from below), wheel to zoom, "reset view"
        in the camera folder. Code: <code>src/components/studio/</code>; nothing on the site imports it.
      </p>
      <div id="studio-root">
        <StudioLab client:only="react" />
      </div>
    </main>
  </body>
</html>
