---
import '../../styles/fonts.css';
import '../../styles/global.css';
import DeskScene from '../../components/scene/DeskScene';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Lab: DeskScene — Open Smart Desk</title>
  </head>
  <body class="bg-bg text-ink" style="min-height: 100vh; padding: 48px 24px 30vh;">
    <main style="max-width: 960px; margin: 0 auto;">
      <p style="font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-ink-muted);">
        Lab — internal preview, not indexed
      </p>
      <h1 style="font-family: var(--font-display); font-size: 2.25rem; margin: 8px 0 16px;">
        DeskScene v3
      </h1>
      <p style="color: var(--color-ink-muted); max-width: 60ch; margin-bottom: 24px;">
        Faceted-light hero scene drawn with the scene kit (DESIGN.md §8). Scroll: the desk starts seated
        and rises as you scroll through this section; the zoom callouts appear once it settles. The
        buttons scroll for you; under reduced motion the scene is static and the buttons switch states.
      </p>
      <noscript>
        <img
          src="/images/scene/desk-scene.webp"
          alt="Illustration of a height-adjustable desk with a sensor box, laser beam and a monitor showing a nudge notification"
          width="960"
          height="600"
          style="width: 100%; border-radius: 20px;"
        />
      </noscript>
      <div id="desk-scene-root">
        <DeskScene client:visible scroll />
      </div>
    </main>
  </body>
</html>
