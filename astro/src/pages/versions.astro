---
import { getCollection } from 'astro:content';
import ReportLayout from '../layouts/ReportLayout.astro';
import StatusPill from '../components/report/StatusPill.astro';
const entries = (await getCollection('updates')).sort((a, b) => b.data.statusDate.valueOf() - a.data.statusDate.valueOf());
---
<ReportLayout title="Version log" description="Versioned status updates for Open Smart Desk."><section class="report-container py-16 md:py-24"><header class="mb-12 max-w-2xl"><p class="mb-3 text-xs font-semibold uppercase tracking-[0.24em] text-brand-text">Project record</p><h1 class="text-4xl text-ink sm:text-5xl">Version log</h1><p class="mt-5 text-lg leading-8 text-ink-muted">Every public update carries a date, state and supersession trail.</p></header><div class="divide-y divide-line border-y border-line">{entries.map((entry) => <article class="py-7"><div class="flex flex-wrap items-center gap-3"><h2 class="text-2xl text-ink">{entry.data.title}</h2><StatusPill state={entry.data.status} /></div><p class="mt-3 max-w-2xl text-ink-muted">{entry.data.description}</p><div class="mt-4 flex flex-wrap gap-4 text-sm text-ink-muted"><time datetime={entry.data.statusDate.toISOString()}>{entry.data.statusDate.toLocaleDateString('en-US')}</time><span>v{entry.data.version}</span>{entry.data.supersedes && <span>supersedes {entry.data.supersedes}</span>}</div><a class="report-link mt-4 inline-block text-sm" href={'/updates/' + entry.id}>Read update</a></article>)}</div></section></ReportLayout>
